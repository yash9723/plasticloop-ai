# PlasticLoop AI — environment template. Copy to `.env` and change every secret.
# Values below are DEVELOPMENT-ONLY defaults. Never reuse them in production.

# development | test | production   (DEMO_MODE is refused when ENVIRONMENT=production)
ENVIRONMENT=development
DEMO_MODE=true

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=plasticloop
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=plasticloop
# Used when running the API on the host (outside Docker):
DATABASE_URL=postgresql+psycopg://plasticloop:change-me-dev-only@localhost:5432/plasticloop
TEST_DATABASE_URL=postgresql+psycopg://plasticloop:change-me-dev-only@localhost:5432/plasticloop_test

# --- Auth ---
JWT_SECRET=dev-only-change-me-to-a-long-random-string-of-64-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# true behind HTTPS (production)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# --- Uploads ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# --- MQTT (Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_SERVICE_USER=plasticloop-service
MQTT_SERVICE_PASSWORD=dev-only-mqtt-service-password
# File the API writes Mosquitto credentials to (shared with the broker container)
MQTT_PASSWD_FILE=./infra/mosquitto/auth/passwd
# Demo devices derive their keys from this (dev/test only)
DEMO_DEVICE_SECRET=dev-only-demo-device-secret

# --- Routing ---
# Optional OSRM base URL (e.g. http://osrm:5000). Empty => straight-line (Haversine) ESTIMATES.
OSRM_URL=
ROUTING_AVG_SPEED_KMPH=25

# --- Vision ---
# auto | trained | demo | manual
VISION_MODE=auto
VISION_MODEL_PATH=./apps/api/models/packaging-cls.pt

LOG_LEVEL=INFO

# --- Web ---
# Where the Next.js server proxies /api/v1/* (baked in at build time)
API_INTERNAL_URL=http://localhost:8000
